# Scratch and collected artifacts are untracked by default; code and docs
# are whitelisted. Mined repos, harbor task dirs, and run outputs are
# regenerable (see README) or belong in a dataset store, not git.
*
!.gitignore
!README.md
!PLAN.md
!pyproject.toml
!convert_to_harbor.py
!enrich_with_codex.py
!build_dataset.py
!scoreboard.py
!gate_tasks.py
!audit_trajectories.py
!baseline_router.py
!profile_router.py
!knn_router.py
!environment_profiles/
!environment_profiles/*.toml
!test_environment_profiles.py
!fill_missing.py
!run_family.sh
!run_gates.sh
!test_fill_missing.py
