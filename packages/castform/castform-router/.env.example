# Local development defaults. Copy this file to .env only when overriding them.
LITELLM_MASTER_KEY=sk-local-dev
LITELLM_SALT_KEY=change-me-before-persisting-real-credentials
LITELLM_DB_PASSWORD=litellm-local-db
UI_USERNAME=admin
UI_PASSWORD=sk-local-dev

CASTFORM_AUTO_MODEL=castform-auto
CASTFORM_CHEAP_MODEL=cheap-model
CASTFORM_FRONTIER_MODEL=frontier-model
CASTFORM_ROUTER_SESSION_TTL_SECONDS=3600

# LiteLLM's stable public alias for the route-scoring model. These values use
# the Q4 GGUF through Docker Model Runner on macOS. Keep the alias unchanged
# when replacing the upstream with a fine-tuned checkpoint later. The Compose
# defaults use the mock upstream when no .env file exists.
CASTFORM_ROUTER_UPSTREAM_MODEL=openai/huggingface.co/unsloth/qwen3.5-0.8b-gguf:Q4_K_M
CASTFORM_ROUTER_UPSTREAM_BASE_URL=http://model-runner.docker.internal/engines/v1
CASTFORM_ROUTER_UPSTREAM_API_KEY=not-needed
CASTFORM_ROUTER_MODEL_NAME=castform-router-0.8b
CASTFORM_ROUTER_MODEL_LABEL=Qwen 3.5 0.8B Q4_K_M
CASTFORM_ROUTER_MODEL_STATUS=stock_untrained

# Optional diagnostic overrides. Normal Compose traffic uses
# http://litellm:4000 and LITELLM_MASTER_KEY automatically.
# CASTFORM_ROUTER_MODEL_BASE_URL=http://litellm:4000
# CASTFORM_ROUTER_MODEL_API_KEY=sk-local-dev

# The default Compose stack uses the bundled mock upstream, so no provider keys
# are needed. Replace the model entries in litellm_config.yaml when connecting
# real providers.
MOCK_UPSTREAM_API_KEY=mock-key
