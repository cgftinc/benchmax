# Copy to litellm/.env. Do not commit real provider credentials.
LITELLM_MASTER_KEY=replace-me

# Qwen scorer served through an OpenAI-compatible endpoint.
CASTFORM_QWEN_MODEL=openai/qwen-router
CASTFORM_QWEN_BASE_URL=http://host.docker.internal:8000/v1
CASTFORM_QWEN_API_KEY=replace-me
CASTFORM_ROUTER_MODEL_NAME=castform-router-qwen
CASTFORM_ROUTER_MODEL_BASE_URL=http://localhost:4000
CASTFORM_ROUTER_MODEL_API_KEY=replace-me
CASTFORM_ROUTER_MODEL_TIMEOUT_SECONDS=60

# LiteLLM backend deployments.
CASTFORM_SMALL_MODEL=openai/small-model
CASTFORM_SMALL_API_KEY=replace-me
CASTFORM_MEDIUM_MODEL=openai/medium-model
CASTFORM_MEDIUM_API_KEY=replace-me
CASTFORM_LARGE_MODEL=openai/large-model
CASTFORM_LARGE_API_KEY=replace-me

# Runtime selection policy. Backend names must match config.yaml model_name values.
CASTFORM_AUTO_MODEL=castform-auto
CASTFORM_ROUTER_QUALITY_THRESHOLD=0.84
CASTFORM_AUTO_FALLBACK_MODEL=large-route
CASTFORM_AUTO_BACKENDS_JSON=[{"name":"small-route","model":"small-model","provider":"provider","estimated_cost_usd":0.05},{"name":"medium-route","model":"medium-model","provider":"provider","estimated_cost_usd":0.10},{"name":"large-route","model":"large-model","provider":"provider","estimated_cost_usd":0.30}]
