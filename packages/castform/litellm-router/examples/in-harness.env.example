# LiteLLM's public key. Change this outside local development.
LITELLM_MASTER_KEY=sk-local-dev

# Local Qwen scorer served by Docker Model Runner.
CASTFORM_ROUTER_UPSTREAM_MODEL=openai/huggingface.co/unsloth/qwen3.5-0.8b-gguf:Q4_K_M
CASTFORM_ROUTER_UPSTREAM_BASE_URL=http://model-runner.docker.internal/engines/v1
CASTFORM_ROUTER_UPSTREAM_API_KEY=not-needed
CASTFORM_ROUTER_MODEL_LABEL=Qwen 3.5 0.8B Q4_K_M
CASTFORM_ROUTER_MODEL_STATUS=stock_untrained

# Example real downstreams. Substitute model IDs and credentials available to
# your provider accounts. Subscription login tokens are not provider API keys.
CASTFORM_GLM_ROUTE_MODEL=openai/<glm-model-id>
CASTFORM_GLM_ROUTE_BASE_URL=<glm-openai-compatible-base-url>
CASTFORM_GLM_ROUTE_API_KEY=<glm-api-key>

CASTFORM_CODEX_ROUTE_MODEL=openai/<openai-api-model-id>
CASTFORM_CODEX_ROUTE_BASE_URL=https://api.openai.com/v1
CASTFORM_CODEX_ROUTE_API_KEY=<openai-api-key>

CASTFORM_CLAUDE_ROUTE_MODEL=anthropic/<claude-api-model-id>
CASTFORM_CLAUDE_ROUTE_BASE_URL=https://api.anthropic.com
CASTFORM_CLAUDE_ROUTE_API_KEY=<anthropic-api-key>

# Optional local Llama deployment through Ollama. Add llama-route to the JSON
# route catalog below if you want Qwen to consider it.
CASTFORM_LLAMA_ROUTE_MODEL=ollama/llama3.3
CASTFORM_LLAMA_ROUTE_BASE_URL=http://host.docker.internal:11434
CASTFORM_LLAMA_ROUTE_API_KEY=not-needed

# Qwen sees model/provider metadata but never prices. Castform applies these
# live cost estimates after Qwen returns its scores.
CASTFORM_AUTO_ROUTES_JSON=[{"gateway_model":"glm-route","model":"<glm-model-id>","provider":"zai","estimated_cost_usd":0.08,"compatible_harnesses":["claude-code","openai-compatible"]},{"gateway_model":"codex-route","model":"<openai-api-model-id>","provider":"openai","estimated_cost_usd":0.18,"compatible_harnesses":["codex","openai-compatible"]},{"gateway_model":"claude-route","model":"<claude-api-model-id>","provider":"anthropic","estimated_cost_usd":0.30,"compatible_harnesses":["claude-code","openai-compatible"]},{"gateway_model":"llama-route","model":"llama3.3","provider":"ollama","estimated_cost_usd":0.00,"compatible_harnesses":["openai-compatible"]}]
