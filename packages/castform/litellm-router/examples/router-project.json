{
  "schema_version": "1",
  "name": "click-private-router",
  "auth_profiles": {
    "public-github": {
      "strategy": "public"
    },
    "company-github": {
      "strategy": "github_app",
      "app_id_env": "CASTFORM_GITHUB_APP_ID",
      "private_key_env": "CASTFORM_GITHUB_PRIVATE_KEY",
      "installation_id_env": "CASTFORM_GITHUB_INSTALLATION_ID",
      "installation_token_env": "CASTFORM_GITHUB_INSTALLATION_TOKEN"
    }
  },
  "repositories": [
    {
      "repo": "pallets/click",
      "revision": "main",
      "auth_profile": "public-github"
    }
  ],
  "pull_requests": {
    "limit_per_repo": 20,
    "eval_ratio": 0.2,
    "include_body": false,
    "exclude_labels": [
      "dependencies"
    ]
  },
  "allowed_routes": [
    "claude-code/opus@anthropic",
    "claude-code/sonnet@anthropic",
    "codex/5.6-balanced@openai",
    "codex/5.6-deep@openai"
  ],
  "benchmark": {
    "repetitions": 1,
    "average_run_cost_usd": 1.0,
    "execution": "castform_hosted"
  }
}
